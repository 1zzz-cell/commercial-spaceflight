  "trendInsights2025": {
    "year": 2025,
    "title": "2025年行业趋势解读",
    "insights": [
      {
        "icon": "trend-up",
        "title": "商业发射首次占据半壁江山",
        "metric": "54%",
        "text": "全年92次入轨发射中商业发射50次、占比54%，商业运载力量成为年度发射增量的重要主体，发射环节市场化进程明显提速。",
        "source": "国家航天局2026-01-20发布；刘洁等《2025年世界航天发射活动总结》（《中国航天》2026年第1期）",
        "sourceUrl": "https://www.cnsa.gov.cn/n6758823/n6758838/c10726402/content.html"
      },
      {
        "icon": "satellite",
        "title": "入轨载荷以商业卫星为绝对主体",
        "metric": "84%",
        "text": "国家航天局口径下，商业卫星入轨311颗，约占全年入轨卫星的84%。《中国航天》统计的377个是入轨航天器总数，两项统计的对象不同。",
        "source": "国家航天局2026-01-20发布",
        "sourceUrl": "https://www.cnsa.gov.cn/n6758823/n6758838/c10726402/content.html"
      },
      {
        "icon": "building",
        "title": "市场主体数量高速扩容",
        "metric": "+277%",
        "text": "2025年新增商业航天相关存续企业83家、同比增长277%，全国总量达393家，四川、北京、广东、海南等地集聚效应突出。",
        "source": "合合信息启信宝《2026商业航天行业观察报告》（光明网2026-03-24报道）",
        "sourceUrl": "https://tech.gmw.cn/2026-03/24/content_38666898.htm"
      },
      {
        "icon": "coins",
        "title": "资本向头部企业与星座赛道集中",
        "metric": "186亿元",
        "text": "全年一级市场融资67起、合计约186亿元，事件数较2024年回落但单笔金额显著提升，资金集中流向卫星互联网与头部火箭企业。",
        "source": "第三届商业航天发展大会发布口径",
        "sourceUrl": ""
      }
